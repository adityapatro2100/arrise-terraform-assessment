region = "ap-south-1"

# Replace subnet IDs, security group IDs, and key-pair names with existing
# resources in YOUR account. Key pairs must belong to the chosen region.
instances = {
  "web-edge" = {
    instance_type       = "t3.micro"
    root_volume_type    = "gp3"
    root_volume_size_gb = 12
    key_name            = "web-edge-key"
    subnet_id           = "subnet-REPLACE_ME"
    security_group_ids  = ["sg-REPLACE_ME"]
    environment         = "dev"
    owner               = "platform"
  }
  "api-worker" = {
    instance_type       = "t3.small"
    root_volume_type    = "gp2"
    root_volume_size_gb = 16
    key_name            = "api-worker-key"
    subnet_id           = "subnet-REPLACE_ME"
    security_group_ids  = ["sg-REPLACE_ME"]
    environment         = "dev"
    owner               = "platform"
  }
  "build-agent" = {
    instance_type       = "t3.medium"
    root_volume_type    = "standard"
    root_volume_size_gb = 24
    key_name            = "build-agent-key"
    subnet_id           = "subnet-REPLACE_ME"
    security_group_ids  = ["sg-REPLACE_ME"]
    environment         = "dev"
    owner               = "build"
  }
  "payments-core" = {
    instance_type       = "m5.large"
    root_volume_type    = "io1"
    root_volume_size_gb = 32
    root_volume_iops    = 1000
    key_name            = "payments-core-key"
    subnet_id           = "subnet-REPLACE_ME"
    security_group_ids  = ["sg-REPLACE_ME"]
    environment         = "production"
    owner               = "payments"
  }
  "analytics-node" = {
    instance_type       = "c5.large"
    root_volume_type    = "io2"
    root_volume_size_gb = 40
    root_volume_iops    = 2000
    key_name            = "analytics-node-key"
    subnet_id           = "subnet-REPLACE_ME"
    security_group_ids  = ["sg-REPLACE_ME"]
    environment         = "staging"
    owner               = "data"
  }
}
