{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ECRAuthenticate",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushOnlyNamedECRRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": "arn:aws:ecr:${region}:${account_a_id}:repository/${ecr_repository_name}"
    },
    {
      "Sid": "RegisterOnlyNamedTaskFamily",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "arn:aws:ecs:${region}:${account_a_id}:task-definition/${ecs_task_family}:*"
    },
    {
      "Sid": "DeployOnlyNamedServiceAndFamily",
      "Effect": "Allow",
      "Action": "ecs:UpdateService",
      "Resource": "arn:aws:ecs:${region}:${account_a_id}:service/${ecs_cluster_name}/${ecs_service_name}",
      "Condition": {
        "ArnLike": {
          "ecs:task-definition": "arn:aws:ecs:${region}:${account_a_id}:task-definition/${ecs_task_family}:*"
        }
      }
    },
    {
      "Sid": "ReadOnlyDeploymentStatus",
      "Effect": "Allow",
      "Action": "ecs:DescribeServices",
      "Resource": "arn:aws:ecs:${region}:${account_a_id}:service/${ecs_cluster_name}/${ecs_service_name}"
    },
    {
      "Sid": "ReadTaskDefinition",
      "Effect": "Allow",
      "Action": "ecs:DescribeTaskDefinition",
      "Resource": "*"
    },
    {
      "Sid": "PassOnlyEcsTaskRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": ["${ecs_task_role_arn}", "${ecs_execution_role_arn}"],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ListOnlyBuildArtifactBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${artifact_bucket_name}"
    },
    {
      "Sid": "ReadOnlyBuildArtifacts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${artifact_bucket_name}/*"
    }
  ]
}
